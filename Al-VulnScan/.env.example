# Optional NVD API key. Do not commit actual credentials.
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_TIMEOUT=20
NVD_RESULTS_LIMIT=20
NVD_RETRIES=2

# Local Ollama endpoint and model (model must already be installed).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT=120

# Conservative scan/resource limits.
SCAN_TIMEOUT=300
MAX_HOST_COUNT=16
MAX_CIDR_SIZE=16
MAX_CUSTOM_PORTS=256

# Local output and history locations.
REPORT_OUTPUT_DIR=reports
SCAN_STORAGE_DIR=scan_history
LOG_LEVEL=INFO

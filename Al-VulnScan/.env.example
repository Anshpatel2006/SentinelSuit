# ==========================================
# AI-VulnScan - Environment Configuration
# ==========================================

# ------------------------------------------
# 1. NVD - National Vulnerability Database
# ------------------------------------------
# Get a key from:
# https://nvd.nist.gov/developers/request-an-api-key

NVD_API_KEY=DF11729F-5C19-4B3B-9EA1-8C5E003671FC

# ------------------------------------------
# 2. Ollama - Local AI model
# ------------------------------------------
# Ollama normally runs locally and does not require an API key.

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest


# ------------------------------------------
# 3. VirusTotal - Optional threat intelligence
# ------------------------------------------
# Add a key only if your project integrates VirusTotal.

VIRUSTOTAL_API_KEY=


# ------------------------------------------
# 4. Google Safe Browsing - Optional URL checking
# ------------------------------------------
# Add a key only if your project integrates this API.

GOOGLE_SAFE_BROWSING_API_KEY=
# SentinelIDS Snort-Compatible Signature Rules
# Format: alert <protocol> <src_ip> <src_port> -> <dst_ip> <dst_port> (msg:"..."; content:"..."; priority:<1-3>; classtype:<category>; sid:<id>; rev:<rev>;)

# --- RECONNAISSANCE & SCANNING ---
alert tcp any any -> any any (msg:"SCAN Nmap TCP SYN Sweep / Stealth Scan detected"; flags:S; priority:2; classtype:attempted-recon; sid:1000001; rev:1;)
alert tcp any any -> any any (msg:"SCAN TCP NULL Scan Detected (No Flags Set)"; flags:0; priority:2; classtype:attempted-recon; sid:1000002; rev:1;)
alert tcp any any -> any any (msg:"SCAN TCP Xmas Tree Scan Detected (FPU Flags Set)"; flags:FPU; priority:2; classtype:attempted-recon; sid:1000003; rev:1;)
alert tcp any any -> any any (msg:"SCAN TCP FIN Scan Detected"; flags:F; priority:2; classtype:attempted-recon; sid:1000004; rev:1;)
alert tcp any any -> any any (msg:"SCAN Recon Scanner User-Agent (Nikto/Sqlmap/DirBuster)"; content:"sqlmap"; priority:2; classtype:attempted-recon; sid:1000005; rev:1;)
alert tcp any any -> any any (msg:"SCAN Recon Scanner User-Agent (Nikto)"; content:"Nikto"; priority:2; classtype:attempted-recon; sid:1000006; rev:1;)

# --- DENIAL OF SERVICE (DoS/DDoS) ---
alert tcp any any -> any any (msg:"DOS Potential TCP SYN Flood anomaly"; flags:S; threshold:type threshold, track by_dst, count 50, seconds 5; priority:1; classtype:attempted-dos; sid:1000010; rev:1;)
alert icmp any any -> any any (msg:"DOS Large ICMP Ping Flood / Smurf Attack"; itype:8; dsize:>1000; priority:1; classtype:attempted-dos; sid:1000011; rev:1;)
alert udp any any -> any any (msg:"DOS High Volume UDP Flood Anomaly"; priority:1; classtype:attempted-dos; sid:1000012; rev:1;)
alert tcp any any -> any 80 (msg:"DOS Slowloris Incomplete HTTP Request Pattern"; content:"X-a: b"; priority:1; classtype:attempted-dos; sid:1000013; rev:1;)

# --- WEB APPLICATION ATTACKS ---
alert tcp any any -> any 80,443,8000,8080 (msg:"EXPLOIT SQL Injection - UNION SELECT statement detected"; content:"UNION SELECT"; nocase; priority:1; classtype:web-application-attack; sid:1000020; rev:1;)
alert tcp any any -> any 80,443,8000,8080 (msg:"EXPLOIT SQL Injection - Tautology 'OR 1=1' detected"; content:"' OR '1'='1"; nocase; priority:1; classtype:web-application-attack; sid:1000021; rev:1;)
alert tcp any any -> any 80,443,8000,8080 (msg:"EXPLOIT Directory Traversal / Path Traversal attempt"; content:"../../"; priority:1; classtype:web-application-attack; sid:1000022; rev:1;)
alert tcp any any -> any 80,443,8000,8080 (msg:"EXPLOIT /etc/passwd Access Attempt"; content:"/etc/passwd"; priority:1; classtype:web-application-attack; sid:1000023; rev:1;)
alert tcp any any -> any 80,443,8000,8080 (msg:"EXPLOIT Cross-Site Scripting (XSS) Tag Injection"; content:"<script>"; nocase; priority:2; classtype:web-application-attack; sid:1000024; rev:1;)
alert tcp any any -> any any (msg:"EXPLOIT Apache Log4j JNDI Remote Code Execution"; content:"${jndi:"; nocase; priority:1; classtype:web-application-attack; sid:1000025; rev:1;)

# --- BRUTE FORCE & INFILTRATION ---
alert tcp any any -> any 22 (msg:"AUTH Multiple Failed SSH Authentication Attempts (Brute Force)"; threshold:type threshold, track by_src, count 10, seconds 10; priority:1; classtype:attempted-admin; sid:1000030; rev:1;)
alert tcp any any -> any 21 (msg:"AUTH Repeated FTP Login Attempts (Brute Force)"; threshold:type threshold, track by_src, count 8, seconds 10; priority:2; classtype:attempted-admin; sid:1000031; rev:1;)
alert tcp any any -> any 23 (msg:"POLICY Insecure Telnet Connection Initiated"; priority:3; classtype:policy-violation; sid:1000032; rev:1;)
alert tcp any any -> any 445 (msg:"EXPLOIT SMB Potential EternalBlue/WannaCry Probe"; content:"SMB"; priority:1; classtype:trojan-activity; sid:1000033; rev:1;)
